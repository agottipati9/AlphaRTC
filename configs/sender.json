{
    "serverless_connection": {
        "autoclose": 120,
        "sender": {
            "enabled": true,
            "dest_ip": "127.0.0.1",
            "dest_port": 8000
        },
        "receiver": {
            "enabled": false
        }
    },
    "bwe_feedback_duration": 50,
    "video_source": {
        "video_disabled": {
            "enabled": false
        },
        "webcam": {
            "enabled": false
        },
        "video_file": {
            "enabled": true,
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "file_path": "/opt/home_dir/sample_media/1080p.yuv"
        }
    },
    "audio_source": {
        "microphone": {
            "enabled": false
        },
        "audio_file": {
            "enabled": true,
            "file_path": "/opt/home_dir/sample_media/audio.wav"
        }
    },
    "save_to_file": {
        "enabled": false,
        "audio": {
            "file_path": "/opt/home_dir/outputs/sender_outaudio.wav"
        },
        "video": {
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "file_path": "/opt/home_dir/outputs/sender_unlimited-60s.yuv"
        }
    },
    "logging": {
        "enabled": true,
        "log_output_path": "/opt/home_dir/outputs/sender.log"
    }
}